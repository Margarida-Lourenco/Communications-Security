from Compiler.types import sint, Array
from Compiler.library import print_ln

# ------------------------------------------------------------
# Dark Auction config
# ------------------------------------------------------------
N_ASSETS  = 4
N_PARTIES = 3
N_ORDERS  = 4

TOTAL_ORDERS = N_ORDERS * N_PARTIES

def next_power_of_two(x):
    r = 1
    while r < x:
        r *= 2
    return r

REAL_PRICES_PER_ASSET   = 2 * TOTAL_ORDERS
SORTED_PRICES_PER_ASSET = next_power_of_two(REAL_PRICES_PER_ASSET)

MAX_PRICE = sint(10**9, size=N_ASSETS)

# ------------------------------------------------------------
# Batcher odd-even merge sort
# ------------------------------------------------------------
def compare_swap(arr, i, j):
    swap   = arr[i] > arr[j]
    tmp    = arr[i]
    arr[i] = swap.if_else(arr[j], arr[i])
    arr[j] = swap.if_else(tmp,    arr[j])

def odd_even_merge(arr, lo, n, r):
    step = r * 2
    if step < n:
        odd_even_merge(arr, lo,     n, step)
        odd_even_merge(arr, lo + r, n, step)
        for i in range(lo + r, lo + n - r, step):
            compare_swap(arr, i, i + r)
    else:
        compare_swap(arr, lo, lo + r)

def odd_even_merge_sort_rec(arr, lo, n):
    if n > 1:
        m = n // 2
        odd_even_merge_sort_rec(arr, lo,     m)
        odd_even_merge_sort_rec(arr, lo + m, m)
        odd_even_merge(arr, lo, n, 1)

def odd_even_merge_sort(arr, start, n):
    odd_even_merge_sort_rec(arr, start, n)
    return arr

# ------------------------------------------------------------
# SIMD pro-rata allocation
# ------------------------------------------------------------
def pro_rata_fills(quantities, total_eligible, volume):
    fills   = [sint(0, size=N_ASSETS) for _ in range(TOTAL_ORDERS)]
    is_full = [sint(0, size=N_ASSETS) for _ in range(TOTAL_ORDERS)]

    safe_total = total_eligible + (total_eligible == 0)
    allocated  = sint(0, size=N_ASSETS)

    for i in range(TOTAL_ORDERS):
        fills[i]   = (quantities[i] * volume).int_div(safe_total, 32)
        allocated += fills[i]
        is_full[i] = (fills[i] == quantities[i])

    remaining = volume - allocated
    done      = (remaining == 0)

    for _ in range(TOTAL_ORDERS):
        for j in range(TOTAL_ORDERS):
            can_receive = sint(1, size=N_ASSETS) - is_full[j]
            increment   = done.if_else(sint(0, size=N_ASSETS), can_receive)
            fills[j]   += increment
            is_full[j]  = (fills[j] == quantities[j])
            remaining  -= increment
            done        = (remaining == 0)

    return fills

# ------------------------------------------------------------
# SIMD clearing price
# ------------------------------------------------------------
def clearing_price(prices, demand, supply, n):
    best_volume = sint(0, size=N_ASSETS)
    first_price = sint(0, size=N_ASSETS)
    last_price  = sint(0, size=N_ASSETS)
    found       = sint(0, size=N_ASSETS)

    for i in range(n):
        volume      = sint.min(demand[i], supply[i])
        better      = volume > best_volume
        best_volume = better.if_else(volume, best_volume)

    for i in range(n):
        volume      = sint.min(demand[i], supply[i])
        is_max      = (volume == best_volume)
        is_first    = ((found == 0) & is_max)
        first_price = is_first.if_else(prices[i], first_price)
        last_price  = is_max.if_else(prices[i], last_price)
        found      += is_max

    return first_price + last_price

# ------------------------------------------------------------
# Pack N_ASSETS scalar sints into one SIMD vector
# ------------------------------------------------------------
def pack(scalars):
    a = Array(N_ASSETS, sint)
    for k in range(N_ASSETS):
        a[k] = scalars[k]
    return a.get_vector()

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def main():
    print_ln("\n=== Dark Auction MPC (SIMD – %s assets in parallel) ===\n",
             N_ASSETS)

    # ----------------------------------------------------------
    # Read inputs
    # ----------------------------------------------------------
    raw_bid_p = [[sint(0)] * TOTAL_ORDERS for _ in range(N_ASSETS)]
    raw_bid_q = [[sint(0)] * TOTAL_ORDERS for _ in range(N_ASSETS)]
    raw_ask_p = [[sint(0)] * TOTAL_ORDERS for _ in range(N_ASSETS)]
    raw_ask_q = [[sint(0)] * TOTAL_ORDERS for _ in range(N_ASSETS)]

    for asset in range(N_ASSETS):
        for party in range(N_PARTIES):
            for order in range(N_ORDERS):
                idx = order + party * N_ORDERS
                raw_bid_p[asset][idx] = sint.get_input_from(party)
                raw_bid_q[asset][idx] = sint.get_input_from(party)
                raw_ask_p[asset][idx] = sint.get_input_from(party)
                raw_ask_q[asset][idx] = sint.get_input_from(party)

    # ----------------------------------------------------------
    # Pack into SIMD vectors:
    #   bid_prices[i][k] = asset k, order slot i
    # ----------------------------------------------------------
    bid_prices = [pack([raw_bid_p[k][i] for k in range(N_ASSETS)]) for i in range(TOTAL_ORDERS)]
    bid_qties  = [pack([raw_bid_q[k][i] for k in range(N_ASSETS)]) for i in range(TOTAL_ORDERS)]
    ask_prices = [pack([raw_ask_p[k][i] for k in range(N_ASSETS)]) for i in range(TOTAL_ORDERS)]
    ask_qties  = [pack([raw_ask_q[k][i] for k in range(N_ASSETS)]) for i in range(TOTAL_ORDERS)]

    # ----------------------------------------------------------
    # Build & sort price list
    # ----------------------------------------------------------
    all_prices = [sint(0, size=N_ASSETS) for _ in range(SORTED_PRICES_PER_ASSET)]

    for i in range(TOTAL_ORDERS):
        all_prices[i]                = ask_prices[i]
        all_prices[i + TOTAL_ORDERS] = bid_prices[i]
    for i in range(2 * TOTAL_ORDERS, SORTED_PRICES_PER_ASSET):
        all_prices[i] = MAX_PRICE

    all_prices = odd_even_merge_sort(all_prices, 0, SORTED_PRICES_PER_ASSET)

    # ----------------------------------------------------------
    # Supply curve
    # ----------------------------------------------------------
    supply     = [sint(0, size=N_ASSETS) for _ in range(REAL_PRICES_PER_ASSET)]
    running_s  = sint(0, size=N_ASSETS)
    prev_price = sint(0, size=N_ASSETS)

    for i in range(REAL_PRICES_PER_ASSET):
        p       = all_prices[i]
        delta_s = sint(0, size=N_ASSETS)
        for j in range(TOTAL_ORDERS):
            matched  = (ask_prices[j] == p)
            delta_s += matched * ask_qties[j]
        if i == 0:
            running_s += delta_s
        else:
            same      = (p == prev_price)
            running_s = same.if_else(running_s, running_s + delta_s)
        supply[i]  = running_s
        prev_price = p

    # ----------------------------------------------------------
    # Demand curve
    # ----------------------------------------------------------
    demand     = [sint(0, size=N_ASSETS) for _ in range(REAL_PRICES_PER_ASSET)]
    running_d  = sint(0, size=N_ASSETS)
    prev_price = sint(0, size=N_ASSETS)

    for i in range(REAL_PRICES_PER_ASSET - 1, -1, -1):
        p       = all_prices[i]
        delta_d = sint(0, size=N_ASSETS)
        for j in range(TOTAL_ORDERS):
            matched  = (bid_prices[j] == p)
            delta_d += matched * bid_qties[j]
        if i == (REAL_PRICES_PER_ASSET - 1):
            running_d += delta_d
        else:
            same      = (p == prev_price)
            running_d = same.if_else(running_d, running_d + delta_d)
        demand[i]  = running_d
        prev_price = p

    # ----------------------------------------------------------
    # Clearing price
    # ----------------------------------------------------------
    cp = clearing_price(
        all_prices[:REAL_PRICES_PER_ASSET],
        demand, supply, REAL_PRICES_PER_ASSET
    )

    # ----------------------------------------------------------
    # Eligible quantities
    # ----------------------------------------------------------
    bid_quantities = [sint(0, size=N_ASSETS) for _ in range(TOTAL_ORDERS)]
    ask_quantities = [sint(0, size=N_ASSETS) for _ in range(TOTAL_ORDERS)]
    total_bid      = sint(0, size=N_ASSETS)
    total_ask      = sint(0, size=N_ASSETS)

    for i in range(TOTAL_ORDERS):
        eligible_bid      = (2 * bid_prices[i] >= cp)
        eligible_ask      = (2 * ask_prices[i] <= cp)
        bid_quantities[i] = eligible_bid * bid_qties[i]
        ask_quantities[i] = eligible_ask * ask_qties[i]
        total_bid        += bid_quantities[i]
        total_ask        += ask_quantities[i]

    volume = sint.min(total_bid, total_ask)

    # ----------------------------------------------------------
    # Pro-rata fills
    # ----------------------------------------------------------
    bid_fills = pro_rata_fills(bid_quantities, total_bid, volume)
    ask_fills = pro_rata_fills(ask_quantities, total_ask, volume)

    # ----------------------------------------------------------
    # Reveal results
    # ----------------------------------------------------------
    cp_open = cp.reveal()

    for i in range(TOTAL_ORDERS):
        print_ln("Order %s of asset %s bought %s units", i, asset, bid_fills[i].reveal())
        print_ln("Order %s of asset %s sold %s units", i, asset, ask_fills[i].reveal())

    print_ln("--- Results ---")
    for asset in range(N_ASSETS):
        int_part = cp_open[asset] // 2
        frac     = cp_open[asset] % 2
        vol_open = volume[asset].reveal()
        print_ln("Asset %s  |  Clearing Price: %s.%s  |  Volume: %s",
                 asset, int_part, frac * 5, vol_open)
        for i in range(TOTAL_ORDERS):
            # bid_fills[i] e ask_fills[i] são vetores de tamanho N_ASSETS
            # .reveal() devolve lista — indexar por asset para obter o valor certo
            bf = bid_fills[i].reveal()
            af = ask_fills[i].reveal()
            print_ln("  Order %s | bought: %s | sold: %s", i, bf[asset], af[asset])

main()