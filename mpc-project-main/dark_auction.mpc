from Compiler.types import sint, Array
from Compiler.library import print_ln

# ------------------------------------------------------------
# Dark Auction config
# ------------------------------------------------------------
N_ASSETS = 1 
N_PARTIES = 3        
N_ORDERS = 10         
VERBOSE = True

# ------------------------------------------------------------
# Bubble sort
# ------------------------------------------------------------
def bubble_sort(prices, qties, ask_prices, ask_qties, n):
    for i in range(n):
        for j in range(n - 1):
            swap = prices[j] > prices[j+1]
            
            temp_price = prices[j]
            prices[j] = swap.if_else(prices[j+1], prices[j])
            prices[j+1] = swap.if_else(temp_price, prices[j+1])
            
            temp_qty = qties[j]
            qties[j] = swap.if_else(qties[j+1], qties[j])
            qties[j+1] = swap.if_else(temp_qty, qties[j+1])
            
            swap = ask_prices[j] < ask_prices[j+1]

            temp_ask = ask_prices[j]
            ask_prices[j] = swap.if_else(ask_prices[j+1], ask_prices[j])
            ask_prices[j+1] = swap.if_else(temp_ask, ask_prices[j+1])
            
            temp_ask_qty = ask_qties[j]
            ask_qties[j] = swap.if_else(ask_qties[j+1], ask_qties[j])
            ask_qties[j+1] = swap.if_else(temp_ask_qty, ask_qties[j+1])
    
    return prices, qties, ask_prices, ask_qties


# ------------------------------------------------------------
# Pro-rata allocation 
# ------------------------------------------------------------


def pro_rata_fills(quantities, total_eligible, volume):
    fills = [sint(0) for _ in range(len(quantities))]
    allocated = sint(0)

    safe_total = total_eligible + (total_eligible == 0)

    for i in range(len(quantities)):
        # int_div(a, b, k) - divis  o inteira com k bits
        fills[i] = (quantities[i] * volume).int_div(safe_total, 32)
        allocated += fills[i]

    residual = volume - allocated
    fills[0] += residual

    return fills




# ------------------------------------------------------------
# CLEARING PRICE
# ------------------------------------------------------------
def clearing_price(demand, supply, prices, n):
    print_ln("\nComputing clearing price...")
    
    # First, find maximum volume
    best_volume = sint(0)
    
    for i in range(n):
        volume = sint.min(demand[i], supply[i])
        is_better = volume > best_volume
        best_volume = is_better.if_else(volume, best_volume)
    
    print_ln("Maximum volume: %s", best_volume.reveal())
    
    # Find first and last price that achieve best_volume
    first_price = sint(0)
    last_price = sint(0)
    found = sint(0)
    
    for i in range(n):
        volume = sint.min(demand[i], supply[i])
        is_max = (volume == best_volume)
        
        # First price (lowest index)
        is_first = (found == 0) & is_max
        first_price = is_first.if_else(prices[i], first_price)
        
        # Always update last_price when is_max is true
        last_price = is_max.if_else(prices[i], last_price)
        
        found = found + is_max
    
    # Midpoint of the plateau
    clearing_price = (first_price + last_price) / 2
    
    print_ln("\n=== Results ===")
    print_ln("Clearing price (midpoint): %s", clearing_price.reveal())
    print_ln("Transaction volume: %s", best_volume.reveal())
    
    return clearing_price, best_volume


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def main():
    print_ln("\n=== Dark Auction with MPC ===\n")
    
    TOTAL_ORDERS = N_ORDERS * N_PARTIES * N_ASSETS
    print_ln("Total orders aggregated: %s", TOTAL_ORDERS)
    
    # Read inputs
    bid_prices = Array(TOTAL_ORDERS, sint)
    bid_qties = Array(TOTAL_ORDERS, sint)
    ask_prices = Array(TOTAL_ORDERS, sint)
    ask_qties = Array(TOTAL_ORDERS, sint)
    
    print_ln("Reading inputs...")
    
    idx = 0
    for party in range(N_PARTIES):
        for asset in range(N_ASSETS):
            for order in range(N_ORDERS):
                bid_prices[idx] = sint.get_input_from(party)
                bid_qties[idx] = sint.get_input_from(party)
                ask_prices[idx] = sint.get_input_from(party)
                ask_qties[idx] = sint.get_input_from(party)
                
                if VERBOSE:
                    print_ln("Order %s (P%s): bid=%s/%s ask=%s/%s", 
                             idx, party,
                             bid_prices[idx].reveal(),
                             bid_qties[idx].reveal(),
                             ask_prices[idx].reveal(),
                             ask_qties[idx].reveal())
                idx += 1
    
    # Sort all orders by bid price (descending)
    print_ln("Sorting orders by bid price...")
    
    sorted_prices = Array(TOTAL_ORDERS, sint)
    sorted_bid_qties = Array(TOTAL_ORDERS, sint)
    sorted_ask_prices = Array(TOTAL_ORDERS, sint)
    sorted_ask_qties = Array(TOTAL_ORDERS, sint)
    
    sorted_prices, sorted_bid_qties, sorted_ask_prices, sorted_ask_qties = bubble_sort(
        bid_prices, bid_qties, ask_prices, ask_qties, TOTAL_ORDERS
    )
    
    # ============================================================
    # BUILD DEMAND AND SUPPLY CURVES
    # ============================================================
    print_ln("Building demand/supply curves...")
    
    # Cumulative demand 
    demand = Array(TOTAL_ORDERS, sint)
    cumulative_bids = sint(0)
    
    for i in range(TOTAL_ORDERS - 1, -1, -1):
        cumulative_bids += sorted_bid_qties[i]
        demand[i] = cumulative_bids
    
    # Cumulative supply 
    supply = Array(TOTAL_ORDERS, sint)
    
    for i in range(TOTAL_ORDERS):
        price_level = sorted_prices[i]
        cumulative_supply = sint(0)
        
        # Sum all asks with price <= current bid price level
        for j in range(TOTAL_ORDERS):
            cumulative_supply += (sorted_ask_prices[j] <= price_level) * sorted_ask_qties[j]
        
        supply[i] = cumulative_supply
    
    if VERBOSE:
        print_ln("\nDemand/Supply curve:")
        for i in range(TOTAL_ORDERS):
            print_ln("Price %s: demand=%s supply=%s", 
                     sorted_prices[i].reveal(),
                     demand[i].reveal(),
                     supply[i].reveal())

                     
    
    print_ln("\nComputing clearing price...")
    cp, volume_result = clearing_price(demand, supply, sorted_prices, TOTAL_ORDERS)
    
    # ============================================================
    # PRO-RATA ALLOCATIONS
    # ============================================================

    print_ln("\nComputing pro-rata allocations...")

    total_eligible_bids = sint(0)
    total_eligible_asks = sint(0)
    # Prepare quantities for both sides
    bid_quantities = [sint(0) for _ in range(TOTAL_ORDERS)]
    ask_quantities = [sint(0) for _ in range(TOTAL_ORDERS)]

    for i in range(TOTAL_ORDERS):
        is_eligible_bid = (sorted_prices[i] >= cp)
        is_eligible_ask = (sorted_ask_prices[i] <= cp)
    
        total_eligible_bids += is_eligible_bid * sorted_bid_qties[i]
        total_eligible_asks += is_eligible_ask * sorted_ask_qties[i]
        bid_quantities[i] = is_eligible_bid * sorted_bid_qties[i]
        ask_quantities[i] = is_eligible_ask * sorted_ask_qties[i]

    is_demand_higher = total_eligible_bids > total_eligible_asks
    volume_to_fill = sint.min(total_eligible_bids, total_eligible_asks)

    

    # Calculate fills for both sides
    bid_fills = pro_rata_fills(bid_quantities, total_eligible_bids, volume_to_fill)
    ask_fills = pro_rata_fills(ask_quantities, total_eligible_asks, volume_to_fill)

    # Choose correct fills based on which side is constrained
    for i in range(TOTAL_ORDERS):
        final_fill = is_demand_higher.if_else(bid_fills[i], ask_fills[i])
        print_ln("Order %s: %s units", i, final_fill.reveal())

    print_ln("\n=== Auction Summary ===")
    print_ln("Clearing Price: %s", cp.reveal())
    print_ln("Total Volume: %s", volume_to_fill.reveal())
    

main()