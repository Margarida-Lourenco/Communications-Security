from Compiler.types import sint, sfix, cint, regint, Array
from Compiler.library import print_ln

# ------------------------------------------------------------
# Dark Auction config
# ------------------------------------------------------------
N_ASSETS = 1 
N_PARTIES = 3        
N_ORDERS = 10         
VERBOSE = False

# ------------------------------------------------------------
# Function clearing price and transaction volume
# ------------------------------------------------------------
def clearing_price(demand, supply, min_price, max_price):

    tamanho = max_price - min_price + 1
    best_volume = sint(0)
    best_price_low = sint(0)
    best_price_high = sint(0)
    
    for idx in range(tamanho):
        p = min_price + idx
        volume = sint.min(demand[idx], supply[idx])
        
        is_better = volume > best_volume
        best_volume = is_better * volume + (1 - is_better) * best_volume
        best_price_low = is_better * p + (1 - is_better) * best_price_low
        best_price_high = is_better * p + (1 - is_better) * best_price_high
        
        is_equal = volume == best_volume
        new_low = sint.min(best_price_low, p)
        new_high = sint.max(best_price_high, p)
        best_price_low = is_equal * new_low + (1 - is_equal) * best_price_low
        best_price_high = is_equal * new_high + (1 - is_equal) * best_price_high
    
    clearing_price = (best_price_low + best_price_high) / 2
    
    return clearing_price, best_volume

# ------------------------------------------------------------
# Pro-rata allocation (safe)
# ------------------------------------------------------------
def pro_rata_fills(quantities, total_eligible, volume):
    fills = [sint(0) for _ in range(len(quantities))]
    allocated = sint(0)

    # evitar divisão por zero
    safe_total = total_eligible + (total_eligible == 0)

    for i in range(len(quantities)):
        fills[i] = (quantities[i] * volume) / safe_total
        allocated += fills[i]
    
    residual = volume - allocated
    fills[0] += residual

    return fills


def vprint_ln(*args):
    if VERBOSE:
        print_ln(*args)


def print_curve(title, curve, max_price):
    vprint_ln(title)
    for price in range(max_price + 1):
        vprint_ln("  Price %s -> %s", price, curve[price].reveal())

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def main():
    print_ln("\n=== Dark Auction with MPC ===\n")
    print_ln("Step 1: Reading inputs...")
    
    # initialize arrays for bids and asks
    bids_price = [[Array(N_ORDERS, sint) for _ in range(N_ASSETS)] for _ in range(N_PARTIES)]
    bids_qty   = [[Array(N_ORDERS, sint) for _ in range(N_ASSETS)] for _ in range(N_PARTIES)]
    asks_price = [[Array(N_ORDERS, sint) for _ in range(N_ASSETS)] for _ in range(N_PARTIES)]
    asks_qty   = [[Array(N_ORDERS, sint) for _ in range(N_ASSETS)] for _ in range(N_PARTIES)]

    for party in range(N_PARTIES):
        for asset in range(N_ASSETS):
            bids_price[party][asset].assign_all(0)
            bids_qty[party][asset].assign_all(0)
            asks_price[party][asset].assign_all(0)
            asks_qty[party][asset].assign_all(0)
    
    # read inputs from parties
    for party in range(N_PARTIES):
        for asset in range(N_ASSETS):
            vprint_ln("Reading Party %s, Asset %s...", party, asset)
            for order in range(N_ORDERS):
                bids_price[party][asset][order] = sint.get_input_from(party)
                bids_qty[party][asset][order] = sint.get_input_from(party)
                asks_price[party][asset][order] = sint.get_input_from(party)
                asks_qty[party][asset][order] = sint.get_input_from(party)
                
                vprint_ln(
                    "  Order %s -> bid price: %s | bid qty: %s | ask price: %s | ask qty: %s",
                    order,
                    bids_price[party][asset][order].reveal(),
                    bids_qty[party][asset][order].reveal(),
                    asks_price[party][asset][order].reveal(),
                    asks_qty[party][asset][order].reveal()
                
                )
                
        vprint_ln("Party_finished")
    
    # Per-asset price ranges (public knowledge)
    max_price = [15]   # single asset, max price
    min_price = [5]    # single asset, min price

    cummulative_demand = [Array(max_price[a] - min_price[a] + 1, sint) for a in range(N_ASSETS)]
    supply             = [Array(max_price[a] - min_price[a] + 1, sint) for a in range(N_ASSETS)]
    cummulative_demand_party = [[Array(max_price[a] - min_price[a] + 1, sint) for a in range(N_ASSETS)] for p in range(N_PARTIES)]
    supply_party             = [[Array(max_price[a] - min_price[a] + 1, sint) for a in range(N_ASSETS)] for p in range(N_PARTIES)]

    vprint_ln("Step 2: Building cummulative_demand/supply curves...")

    for a in range(N_ASSETS):
        print_ln("  assign_all demand asset %s", a)
        cummulative_demand[a].assign_all(0)
        print_ln("  assign_all supply asset %s", a)
        supply[a].assign_all(0)

    for p in range(N_PARTIES):
        for a in range(N_ASSETS):
            print_ln("  assign_all party %s asset %s", p, a)
            cummulative_demand_party[p][a].assign_all(0)
            supply_party[p][a].assign_all(0)
                
    print_ln("cummulative_demand_party and supply_party initialized")

    for p in range(N_PARTIES):
        for a in range(N_ASSETS):
            for j in range(max_price[a] - min_price[a] + 1):
                actual_price = min_price[a] + j
                d_total = sint(0)
                s_total = sint(0)
                for i in range(N_ORDERS):
                    d_mask = (bids_price[p][a][i] >= actual_price)
                    s_mask = (asks_price[p][a][i] <= actual_price)
                    d_total += d_mask * bids_qty[p][a][i]
                    s_total += s_mask * asks_qty[p][a][i]
                cummulative_demand[a][j] = cummulative_demand[a][j] + d_total
                cummulative_demand_party[p][a][j] = d_total
                supply[a][j] = supply[a][j] + s_total
                supply_party[p][a][j] = s_total
                    
    
    print_ln("Step 4: Computing clearing prices and allocations...")
    
    # Clearing + allocation
    for a in range(N_ASSETS):
        print_ln("  Processing Asset %s...", a)
        cp, volume_result = clearing_price(cummulative_demand[a], supply[a], 0, max_price[a] - min_price[a])

        print_ln("\n=== Results ===")
        print_ln("Clearing price: %s", cp.reveal())
        print_ln("Transaction volume: %s", volume_result.reveal())  

        eligible_qties_bids = []
        eligible_qties_asks = []

        demand_at_cp = sint(0)
        supply_at_cp = sint(0)

        for party in range(N_PARTIES):
            for i in range(N_ORDERS):
                mask_bid = (bids_price[party][a][i] >= cp)
                mask_ask = (asks_price[party][a][i] <= cp)

                eligible_qties_bids.append(mask_bid * bids_qty[party][a][i])
                eligible_qties_asks.append(mask_ask * asks_qty[party][a][i])

                demand_at_cp += mask_bid * bids_qty[party][a][i]
                supply_at_cp += mask_ask * asks_qty[party][a][i]

        total_eligible_bids = sint(0)
        for qty in eligible_qties_bids:
            total_eligible_bids += qty

        total_eligible_asks = sint(0)
        for qty in eligible_qties_asks:
            total_eligible_asks += qty

        volume_to_fill = sint.min(demand_at_cp, supply_at_cp)
        is_demand_higher = (demand_at_cp > supply_at_cp)

        fills_bids = pro_rata_fills(eligible_qties_bids, total_eligible_bids, volume_to_fill)
        fills_asks = pro_rata_fills(eligible_qties_asks, total_eligible_asks, volume_to_fill)

        print_ln("\nRationing results:")
        idx = 0
        for party in range(N_PARTIES):
            for i in range(N_ORDERS):
                final_fill = is_demand_higher * fills_bids[idx] + (1 - is_demand_higher) * fills_asks[idx]
                print_ln("  Party %s Order %s: %s units", party, i, final_fill.reveal())
                idx += 1

main()