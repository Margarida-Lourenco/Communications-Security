from Compiler.types import sint, sfix, Array
from Compiler.library import print_ln

# ------------------------------------------------------------
# Dark Auction config
# ------------------------------------------------------------
N_ASSETS = 1 
N_PARTIES = 3        
N_ORDERS = 2         
VERBOSE = True


# Calculate next power of two for bitonic sort padding
def next_power_of_two(value):
    result = 1
    while result < value:
        result *= 2
    return result

# ------------------------------------------------------------
# Bitonic sort
# ------------------------------------------------------------
def compare_and_swap(prices, qties, i, j, ascending):
    if ascending:
        swap = prices[i] > prices[j]
    else:
        swap = prices[i] < prices[j]

    temp_price = prices[i]
    prices[i] = swap.if_else(prices[j], prices[i])
    prices[j] = swap.if_else(temp_price, prices[j])

    temp_qty = qties[i]
    qties[i] = swap.if_else(qties[j], qties[i])
    qties[j] = swap.if_else(temp_qty, qties[j])


def bitonic_sort(prices, qties, n, ascending=True):
    size = 2
    while size <= n:
        step = size // 2
        while step > 0:
            for i in range(n):
                j = i ^ step
                if j > i:
                    up = (i & size) == 0
                    if not ascending:
                        up = not up
                    compare_and_swap(prices, qties, i, j, up)
            step //= 2
        size *= 2

    return prices, qties


# ------------------------------------------------------------
# Pro-rata allocation 
# ------------------------------------------------------------


def pro_rata_fills(quantities, total_eligible, volume):
    fills = [sint(0) for _ in range(len(quantities))]
    allocated = sint(0)

    safe_total = total_eligible + (total_eligible == 0)

    for i in range(len(quantities)):
        # int_div(a, b, k) - divis  o inteira com k bits
        fills[i] = (quantities[i] * volume).int_div(safe_total, 32)
        allocated += fills[i]

    residual = volume - allocated
    fills[0] += residual

    return fills


# ------------------------------------------------------------
# CLEARING PRICE
# ------------------------------------------------------------
def clearing_price(demand, supply, price_levels, n_levels):

    def update_bounds(p_low, p_high, price, volume):
        is_max = volume == best_volume
        p_low  = is_max.if_else(sint.min(p_low, price), p_low)
        p_high = is_max.if_else(sint.max(p_high, price), p_high)
        return p_low, p_high

    # Step 1: best tradeable volume across all price levels
    best_volume = sint(0)
    for i in range(n_levels):
        vol = sint.min(demand[i], supply[i])
        best_volume = (vol > best_volume).if_else(vol, best_volume)

    # Step 2: price plateau bounds — widest range achieving best_volume
    p_low, p_high = sint(10**9), sint(-1)
    for i in range(n_levels):
        p_low, p_high = update_bounds(p_low, p_high, price_levels[i],
                                      sint.min(demand[i], supply[i]))

    # Step 3: clearing price as midpoint of plateau
    cp = (sfix(p_low) + sfix(p_high)) / sfix(2)

    if VERBOSE:
        print_ln("\n--- Demand/Supply Curve ---")
        for i in range(n_levels):
            print_ln("  Price %s: demand=%s supply=%s",
                     price_levels[i].reveal(), demand[i].reveal(), supply[i].reveal())
        print_ln("Best volume : %s", best_volume.reveal())
        print_ln("p_low/p_high: %s / %s", p_low.reveal(), p_high.reveal())
        print_ln("Clearing price: %s | Volume: %s", cp.reveal(), best_volume.reveal())

    return cp, best_volume


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def main():
    print_ln("\n=== Dark Auction with MPC ===\n")
    
    TOTAL_ORDERS = N_ORDERS * N_PARTIES * N_ASSETS
    SORT_SIZE = next_power_of_two(TOTAL_ORDERS)
    print_ln("Total orders aggregated: %s", TOTAL_ORDERS)
    
    # Read inputs
    bid_prices = Array(SORT_SIZE, sint)
    bid_qties = Array(SORT_SIZE, sint)
    ask_prices = Array(SORT_SIZE, sint)
    ask_qties = Array(SORT_SIZE, sint)
    
    print_ln("Reading inputs...")
    
    idx = 0
    for party in range(N_PARTIES):
        for asset in range(N_ASSETS):
            for order in range(N_ORDERS):
                bid_prices[idx] = sint.get_input_from(party)
                bid_qties[idx] = sint.get_input_from(party)
                ask_prices[idx] = sint.get_input_from(party)
                ask_qties[idx] = sint.get_input_from(party)
                
                if VERBOSE:
                    print_ln("Order %s (P%s): bid=%s/%s ask=%s/%s", 
                             idx, party,
                             bid_prices[idx].reveal(),
                             bid_qties[idx].reveal(),
                             ask_prices[idx].reveal(),
                             ask_qties[idx].reveal())
                idx += 1

    # Pad the arrays up to the next power of two so bitonic sort can run.
    # The extra entries are dummy orders: zero quantity means they do not
    # affect the auction, and the extreme prices push them to the end.
    for idx in range(TOTAL_ORDERS, SORT_SIZE):
        bid_prices[idx] = sint(-1)
        bid_qties[idx] = sint(0)
        ask_prices[idx] = sint(10**9)
        ask_qties[idx] = sint(0)
    
    # Sort bids descending and asks ascending using bitonic sort
    print_ln("Sorting orders with bitonic sort...")
    
    sorted_prices, sorted_bid_qties = bitonic_sort(bid_prices, bid_qties, SORT_SIZE, ascending=False)
    sorted_ask_prices, sorted_ask_qties = bitonic_sort(ask_prices, ask_qties, SORT_SIZE, ascending=True)

    # Debug: reveal full sorted lists (including padded entries) to verify ordering
    if VERBOSE:
        print_ln("\n--- Sorted bids (index: price/qty) ---")
        for i in range(SORT_SIZE):
            print_ln("%s: %s / %s", i, sorted_prices[i].reveal(), sorted_bid_qties[i].reveal())

        print_ln("\n--- Sorted asks (index: price/qty) ---")
        for i in range(SORT_SIZE):
            print_ln("%s: %s / %s", i, sorted_ask_prices[i].reveal(), sorted_ask_qties[i].reveal())
    
    # ============================================================
    # BUILD DEMAND AND SUPPLY CURVES
    # ============================================================
    print_ln("Building demand/supply curves...")
    curve_input_size = TOTAL_ORDERS * 2
    curve_size = next_power_of_two(curve_input_size)

    curve_prices = Array(curve_size, sint)
    curve_qties = Array(curve_size, sint)

    for i in range(TOTAL_ORDERS):
        curve_prices[i] = sorted_prices[i]
        curve_qties[i] = sint(0)

    for i in range(TOTAL_ORDERS):
        curve_prices[TOTAL_ORDERS + i] = sorted_ask_prices[i]
        curve_qties[TOTAL_ORDERS + i] = sint(0)

    for i in range(curve_input_size, curve_size):
        curve_prices[i] = sint(-1)
        curve_qties[i] = sint(0)

    curve_prices, curve_qties = bitonic_sort(curve_prices, curve_qties, curve_size, ascending=False)

    # Cumulative demand and supply for all bid and ask price levels
    demand = Array(curve_input_size, sint)
    supply = Array(curve_input_size, sint)

    for i in range(curve_input_size):
        price_level = curve_prices[i]

        cumulative_demand = sint(0)
        for j in range(TOTAL_ORDERS):
            cumulative_demand += (sorted_prices[j] >= price_level) * sorted_bid_qties[j]

        cumulative_supply = sint(0)
        for j in range(TOTAL_ORDERS):
            cumulative_supply += (sorted_ask_prices[j] <= price_level) * sorted_ask_qties[j]

        demand[i] = cumulative_demand
        supply[i] = cumulative_supply

    if VERBOSE:
        print_ln("\nDemand/Supply curve:")
        for i in range(curve_input_size):
            print_ln("Price %s: demand=%s supply=%s", 
                     curve_prices[i].reveal(),
                     demand[i].reveal(),
                     supply[i].reveal())
          
    
    print_ln("\nComputing clearing price...")
    cp, vol = clearing_price(demand, supply, curve_prices, curve_input_size)

    # Reveal clearing price for debugging (do not branch on secret values)
    cp_public = cp.reveal()
    print_ln("Revealed clearing price (public): %s", cp_public)
    # ============================================================
    # PRO-RATA ALLOCATIONS
    # ============================================================

    print_ln("\nComputing pro-rata allocations...")

    total_eligible_bids = sint(0)
    total_eligible_asks = sint(0)
    # Prepare quantities for both sides
    bid_quantities = [sint(0) for _ in range(TOTAL_ORDERS)]
    ask_quantities = [sint(0) for _ in range(TOTAL_ORDERS)]

    for i in range(TOTAL_ORDERS):
        is_eligible_bid = (sorted_prices[i] >= cp)
        is_eligible_ask = (sorted_ask_prices[i] <= cp)
    
        total_eligible_bids += is_eligible_bid * sorted_bid_qties[i]
        total_eligible_asks += is_eligible_ask * sorted_ask_qties[i]
        bid_quantities[i] = is_eligible_bid * sorted_bid_qties[i]
        ask_quantities[i] = is_eligible_ask * sorted_ask_qties[i]

        if VERBOSE:
            print_ln("Order %s: bid_price=%s qty=%s eligible=%s | ask_price=%s qty=%s eligible=%s", 
                     i, sorted_prices[i].reveal(), sorted_bid_qties[i].reveal(), is_eligible_bid.reveal(),
                     sorted_ask_prices[i].reveal(), sorted_ask_qties[i].reveal(), is_eligible_ask.reveal())

    is_demand_higher = total_eligible_bids > total_eligible_asks
    volume_to_fill = sint.min(total_eligible_bids, total_eligible_asks)

    if VERBOSE:
        print_ln("\nTotal eligible bids: %s", total_eligible_bids.reveal())
        print_ln("Total eligible asks: %s", total_eligible_asks.reveal())
        print_ln("Volume to fill (min of both): %s", volume_to_fill.reveal())
        print_ln("Demand higher (0=no,1=yes): %s", is_demand_higher.reveal())

    # Calculate fills for both sides
    bid_fills = pro_rata_fills(bid_quantities, total_eligible_bids, volume_to_fill)
    ask_fills = pro_rata_fills(ask_quantities, total_eligible_asks, volume_to_fill)

    if VERBOSE:
        print_ln("\nBid-side pro-rata fills:")
        for i in range(TOTAL_ORDERS):
            print_ln("  Order %s: %s units", i, bid_fills[i].reveal())

        print_ln("\nAsk-side pro-rata fills:")
        for i in range(TOTAL_ORDERS):
            print_ln("  Order %s: %s units", i, ask_fills[i].reveal())

    # Choose correct fills based on which side is constrained
    if VERBOSE:
        print_ln("\nFinal allocations (demand_higher=%s):", is_demand_higher.reveal())
    
    for i in range(TOTAL_ORDERS):
        final_fill = is_demand_higher.if_else(bid_fills[i], ask_fills[i])
        print_ln("Order %s: %s units", i, final_fill.reveal())

    print_ln("\n=== Auction Summary ===")
    print_ln("Clearing Price: %s", cp.reveal())
    print_ln("Total Volume: %s", volume_to_fill.reveal())
    print_ln("Fills: " + ", ".join(["%s" for _ in range(TOTAL_ORDERS)]), *[bid_fills[i].reveal() for i in range(TOTAL_ORDERS)])
    

main()